# Plantilla de variables de entorno del front (Vite).
# Copia este archivo y renómbralo a .env en la misma carpeta:
#   Windows:  copy example.env .env
#   Linux/Mac: cp example.env .env
#
# Solo las variables con prefijo VITE_ se exponen al navegador.

# --- Google Analytics 4 ---
VITE_GA_MEASUREMENT_ID=G-E0JZ8EXZ6V

