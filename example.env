# Plantilla de variables de entorno del front (Vite).
# Copia este archivo y renómbralo a .env en la misma carpeta:
#   Windows:  copy example.env .env
#   Linux/Mac: cp example.env .env
#
# Solo las variables con prefijo VITE_ se exponen al navegador.

# --- reCAPTCHA v2 (casilla) ---
# Desarrollo (claves de prueba de Google — funcionan en localhost):
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_zXzJxlqG
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Producción: claves v2 Checkbox de https://www.google.com/recaptcha/admin
# Dominios: localhost, 127.0.0.1, acerosocotlan.mx, www.acerosocotlan.mx

# --- Transparencia / buzón de quejas ---
# Destinatarios del primer botón: Irregularidades, abusos o mal servicio
# Varios correos: sepáralos con coma
VITE_TRANSPARENCIA_IRREGULARIDADES_CORREOS=quejas@acerosocotlan.mx,auditoria@acerosocotlan.mx

# Destinatarios del segundo botón: Fraudes
VITE_TRANSPARENCIA_FRAUDES_CORREOS=fraudes@acerosocotlan.mx,seguridad@acerosocotlan.mx
