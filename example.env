# --- API FastAPI (correos) ---
# En desarrollo deja vacío: Vite hace proxy /api → http://127.0.0.1:8000
# En producción: URL pública del backend
VITE_API_URL=

# Destinatarios y remitente SMTP ya NO van aquí: edítalos en fastapi/.env
#   SMTP_FROM                  → remitente (una sola línea)
#   CORREOS_IRREGULARIDADES
#   CORREOS_FRAUDES
#   CORREOS_CONTACTO
