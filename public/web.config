<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fallback SPA para IIS SIN instalar URL Rewrite.
  Si una ruta no existe como archivo (ej. /productos/...), IIS sirve index.html
  y React Router resuelve la navegación (incluye F5 / Enter).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
