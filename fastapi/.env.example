# ============================================================
# Página web Aceros Ocotlán — API de correos
# Copia a .env:  copy .env.example .env
# ============================================================

APP_NAME=Pagina Web API
DEBUG=false

# CORS (front + producción)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://acerosocotlan.mx,https://www.acerosocotlan.mx

# ------------------------------------------------------------
# SMTP
# ------------------------------------------------------------
SMTP_HOST=smtp.hornet.email
SMTP_PORT=587
SMTP_USER=servicio.cliente@acerosocotlan.mx
SMTP_PASSWORD=CAMBIAR_PASSWORD_SMTP

# >>> ÚNICA LÍNEA PARA CAMBIAR EL REMITENTE <<<
SMTP_FROM=servicio.cliente@acerosocotlan.mx

# ------------------------------------------------------------
# Destinatarios (separar varios con coma)
# ------------------------------------------------------------
CORREOS_IRREGULARIDADES=gerente.rh@grupoacerosocotlan.mx,gerente.auditoria@grupoacerosocotlan.mx,ejestrada@grupoacerosocotlan.mx
CORREOS_FRAUDES=gestor.contenidos@acerosocotlan.mx
CORREOS_CONTACTO=ventas@acerosocotlan.mx

RECAPTCHA_SECRET_KEY=CAMBIAR_RECAPTCHA_SECRET
